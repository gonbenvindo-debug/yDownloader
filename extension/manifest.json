{
  "manifest_version": 3,
  "name": "yDownloader",
  "version": "2.2.0",
  "minimum_chrome_version": "116",
  "description": "Descarrega vídeos do YouTube diretamente no browser, sem servidor.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "yDownloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["downloads", "storage", "webRequest", "offscreen", "declarativeNetRequest"],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtubei.googleapis.com/*",
    "https://*.googlevideo.com/*"
  ],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
    "js": ["player-bridge.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
